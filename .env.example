# ---------- Obrigatórias ----------
# PostgreSQL. Local: `npm run db:local` sobe um Postgres embutido na porta 5433.
DATABASE_URL="postgresql://frota:frota-local@localhost:5433/frota"

# Endereço público do app (usado nos links de convite). Em produção, sempre HTTPS.
APP_URL="http://localhost:3100"

# Segredo para assinar links de documentos (mín. 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Chave mestra AES-256 dos anexos (32 bytes em base64). GUARDE UMA CÓPIA FORA DO SERVIDOR:
# sem ela, nenhum documento (nem os backups) pode ser aberto.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FILE_MASTER_KEY=""

# ---------- Armazenamento dos anexos ----------
# s3 (produção: Railway Bucket ou qualquer S3 compatível) | fs (só desenvolvimento/testes)
STORAGE_DRIVER="fs"
STORAGE_FS_DIR=".storage"
# Railway: use referências ${{frota-docs.ENDPOINT}} etc. no serviço.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---------- Backups (scripts/backup.ts) ----------
# Bucket de destino, separado do bucket dos anexos. Sem ele, grava em BACKUP_DIR.
# Railway: ${{frota-backups.BUCKET}}, ${{frota-backups.ENDPOINT}}, ${{frota-backups.ACCESS_KEY_ID}}...
BACKUP_S3_BUCKET=""
BACKUP_S3_ENDPOINT=""
BACKUP_S3_REGION=""
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""
BACKUP_DIR="backups"
